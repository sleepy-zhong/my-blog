
# 后端接口基地址（用于 axios）
VITE_API_BASE_URL=http://localhost:3000

# 上传压缩参数
VITE_ATTACHMENT_COMPRESS=true
VITE_ATTACHMENT_QUALITY=80
VITE_ATTACHMENT_MAX_WIDTH=1920
VITE_ATTACHMENT_MAX_HEIGHT=1080

# 预览 URL：开发环境通常用相对路径
VITE_ATTACHMENT_PREVIEW_ABSOLUTE=false
# 若上面为 true，则需提供绝对基地址
VITE_ATTACHMENT_PREVIEW_BASE_URL=http://localhost:3000

# 是否在编辑器内将 <img> 预览升级为 blob:，便于带鉴权预览
VITE_ATTACHMENT_PREVIEW_UPGRADE_BLOB=true
# 前端配置
