# 前端生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# API基础URL - 你的域名
VITE_API_BASE_URL=https://yourdomain.com/api

# 或者使用IP地址（如果没有域名）
# VITE_API_BASE_URL=http://your-server-ip:3000/api

# 网站标题
VITE_APP_TITLE=SleepyZhong Blog

# 网站描述
VITE_APP_DESCRIPTION=个人技术博客

# 是否启用调试模式
VITE_DEBUG=false

# 文件上传大小限制（字节）
VITE_MAX_FILE_SIZE=10485760

# 支持的图片格式
VITE_SUPPORTED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
