# 生产环境模板
# 使用方式：
# 1. 复制为 .env.production
# 2. 将所有 replace_me_* / your_* 占位值替换为真实生产值

NODE_ENV=production
PORT=3000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=techblogdb
MYSQL_USER=blogapp
MYSQL_PASSWORD=replace_me_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_me_mysql_root_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_me_redis_password
REDIS_ENABLED=true

# JWT
# 生产必须替换为至少 64 位随机字符串
JWT_SECRET=replace_me_with_a_long_random_jwt_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
JWT_ACCESS_COOKIE_NAME=blog_access_token
JWT_REFRESH_COOKIE_NAME=blog_refresh_token
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_SECURE=true
JWT_COOKIE_DOMAIN=

# 站点 URL
PUBLIC_SITE_URL=https://sleepyzhong.top
PUBLIC_API_URL=https://sleepyzhong.top/api
PUBLIC_SITE_NAME=sleepyzhong的游乐场
PUBLIC_SITE_DESCRIPTION=一个技术博客与个人站点
PUBLIC_LOGO_URL=
PUBLIC_FAVICON_URL=
PUBLIC_BASE_URL=https://sleepyzhong.top
CORS_ALLOWED_ORIGINS=https://sleepyzhong.top,https://www.sleepyzhong.top

# SMTP
# 如果线上继续使用同一套发信服务，这组值可以和你当前线上保持一致
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_real_smtp_user@qq.com
SMTP_PASS=replace_me_smtp_auth_code
SMTP_FROM=your_real_smtp_user@qq.com

# 上传
UPLOAD_PATH=/app/uploads
UPLOAD_IMAGES_PATH=/app/uploads/images
UPLOAD_AVATERS_PATH=/app/uploads/avaters
MAX_FILE_SIZE=5242880
REQUEST_BODY_LIMIT=1mb
UPLOAD_CACHE_MAX_AGE_SECONDS=604800

# 功能开关
ALLOW_DATA_URI_IN_ARTICLE=false
ENABLE_ARTICLE_IMPORT=false
ENABLE_ATTACHMENT_ARCHIVE=false
ENABLE_ATTACHMENT_RECOMPRESS=false
PUBLIC_ATTACHMENT_PREVIEW=false
ENABLE_API_DOCS=false
RISK_GUARD_ENABLED=true
DB_SYNC_ON_START=false

# 运行参数
NODE_OPTIONS=--max-old-space-size=160
BCRYPT_ROUNDS=10
TRUST_PROXY=1
ONLINE_ACTIVE_WINDOW_MINUTES=5
SESSION_TOUCH_INTERVAL_SECONDS=60
