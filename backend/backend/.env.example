MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=techblogdb
MYSQL_USER=root
MYSQL_PASSWORD=root123

JWT_SECRET=replace_with_a_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
JWT_ACCESS_COOKIE_NAME=blog_access_token
JWT_REFRESH_COOKIE_NAME=blog_refresh_token
PORT=3001

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=example@qq.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM=example@qq.com

UPLOAD_PATH=uploads
UPLOAD_IMAGES_PATH=uploads/images
UPLOAD_AVATERS_PATH=uploads/avaters
MAX_FILE_SIZE=10485760

PUBLIC_SITE_URL=http://localhost:10001
PUBLIC_API_URL=http://127.0.0.1:3001
CORS_ALLOWED_ORIGINS=http://localhost:10001,http://127.0.0.1:10001,http://localhost:5173,http://127.0.0.1:5173

JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_SECURE=false
JWT_COOKIE_DOMAIN=
ONLINE_ACTIVE_WINDOW_MINUTES=5
SESSION_TOUCH_INTERVAL_SECONDS=60

BCRYPT_ROUNDS=10
PUBLIC_ATTACHMENT_PREVIEW=true
ENABLE_API_DOCS=true
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
TRUST_PROXY=1
RISK_GUARD_ENABLED=true
DB_SYNC_ON_START=false
